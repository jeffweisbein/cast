<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.besttechie.cast-push-relay</string>
  <key>ProgramArguments</key><array><string>/opt/homebrew/bin/node</string><string>REPLACE_SOURCE_DIRECTORY/src/main.js</string></array>
  <key>WorkingDirectory</key><string>REPLACE_SOURCE_DIRECTORY</string>
  <key>EnvironmentVariables</key><dict>
    <key>CAST_RELAY_STATE_DIR</key><string>REPLACE_PRIVATE_STATE_DIRECTORY</string>
    <key>CAST_APNS_KEY_PATH</key><string>REPLACE_PRODUCTION_KEY_PATH</string>
    <key>CAST_APNS_KEY_ID</key><string>REPLACE_KEY_ID</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>REPLACE_PRIVATE_LOG_DIRECTORY/stdout.log</string>
  <key>StandardErrorPath</key><string>REPLACE_PRIVATE_LOG_DIRECTORY/stderr.log</string>
</dict></plist>
